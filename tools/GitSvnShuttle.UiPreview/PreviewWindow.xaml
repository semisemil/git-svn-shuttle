<Window x:Class="GitSvnShuttle.UiPreview.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Git-SVN Shuttle UI Preview" Width="1320" Height="860"
        MinWidth="500" MinHeight="420" Background="#16181D">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="48" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="#20232A" BorderBrush="#323640" BorderThickness="0,0,0,1">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
        <TextBlock Text="실제 XAML 프리뷰" Foreground="White" FontWeight="SemiBold"
                   VerticalAlignment="Center" Margin="0,0,18,0" />
        <Button Content="Dark" Click="OnDarkClick" Padding="12,4" Margin="0,0,6,0" />
        <Button Content="Light" Click="OnLightClick" Padding="12,4" Margin="0,0,18,0" />
        <Button Content="420px" Click="OnCompactClick" Padding="12,4" Margin="0,0,6,0" />
        <Button Content="1280px" Click="OnWideClick" Padding="12,4" />
      </StackPanel>
    </Border>

    <Border Grid.Row="1" Margin="18" BorderBrush="#404550" BorderThickness="1">
      <ContentControl x:Name="PreviewHost" HorizontalContentAlignment="Stretch"
                      VerticalContentAlignment="Stretch" />
    </Border>
  </Grid>
</Window>
