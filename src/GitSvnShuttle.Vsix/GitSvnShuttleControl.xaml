<UserControl x:Class="GitSvnShuttle.Vsix.GitSvnShuttleControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
             MinWidth="420" MinHeight="280" PreviewKeyDown="OnPreviewKeyDown"
             Background="{DynamicResource {x:Static shell:VsBrushes.ToolWindowBackgroundKey}}"
             Foreground="{DynamicResource {x:Static shell:VsBrushes.ToolWindowTextKey}}">
  <UserControl.Resources>
    <Geometry x:Key="ChevronGeometry">M 3,5 L 8,10 13,5</Geometry>
    <Geometry x:Key="RefreshGeometry">M 17,7 C 15.8,4 13.1,2 10,2 C 6.7,2 3.9,4.1 2.8,7 M 17,7 L 17,2 M 17,7 L 12,7 M 3,13 C 4.2,16 6.9,18 10,18 C 13.3,18 16.1,15.9 17.2,13 M 3,13 L 3,18 M 3,13 L 8,13</Geometry>
    <Geometry x:Key="DownloadGeometry">M 10,2 L 10,13 M 5,9 L 10,14 15,9 M 3,18 L 17,18</Geometry>
    <Geometry x:Key="UploadGeometry">M 10,18 L 10,7 M 5,11 L 10,6 15,11 M 3,2 L 17,2</Geometry>
    <Geometry x:Key="RepositoryGeometry">M 4,2 L 16,2 16,18 5,18 C 3,18 3,16 3,15 L 3,4 C 3,3 4,2 5,2 M 7,2 L 7,18</Geometry>
    <Geometry x:Key="WarningGeometry">M 10,2 L 18,17 2,17 Z M 10,7 L 10,12 M 10,15 L 10,15.1</Geometry>
    <Geometry x:Key="ServerGeometry">M 3,2 L 17,2 17,8 3,8 Z M 3,12 L 17,12 17,18 3,18 Z M 6,5 L 6.1,5 M 6,15 L 6.1,15</Geometry>
    <Geometry x:Key="CheckGeometry">M 3,10 L 8,15 17,5</Geometry>
    <Geometry x:Key="SettingsGeometry">M 8.5,2 L 11.5,2 12.2,4.1 14,5.1 16.1,4.5 17.6,7.1 16.1,8.6 16.1,10.7 17.6,12.3 16.1,14.9 14,14.3 12.2,15.3 11.5,17.5 8.5,17.5 7.8,15.3 6,14.3 3.9,14.9 2.4,12.3 3.9,10.7 3.9,8.6 2.4,7.1 3.9,4.5 6,5.1 7.8,4.1 Z M 10,7 A 3,3 0 1 1 10,13 A 3,3 0 1 1 10,7</Geometry>
    <Geometry x:Key="FolderGeometry">M 2,5 L 8,5 10,7 18,7 18,17 2,17 Z M 2,7 L 2,4 8,4 10,6</Geometry>
    <Geometry x:Key="SearchGeometry">M 9,3 A 6,6 0 1 1 9,15 A 6,6 0 1 1 9,3 M 13.5,13.5 L 18,18</Geometry>
    <Geometry x:Key="ResetGeometry">M 5,6 L 2,6 2,3 M 2,6 A 8,8 0 1 1 3.5,14.5</Geometry>
    <Geometry x:Key="CloseGeometry">M 4,4 L 16,16 M 16,4 L 4,16</Geometry>
    <Geometry x:Key="StopGeometry">M 5,5 L 15,5 15,15 5,15 Z</Geometry>
    <Geometry x:Key="EyeGeometry">M 2,10 C 5,4 15,4 18,10 C 15,16 5,16 2,10 M 10,7 A 3,3 0 1 1 10,13 A 3,3 0 1 1 10,7</Geometry>

    <Style x:Key="IconButton" TargetType="Button">
      <Setter Property="Width" Value="28"/><Setter Property="Height" Value="28"/><Setter Property="Padding" Value="6"/>
      <Setter Property="Foreground" Value="{DynamicResource {x:Static shell:VsBrushes.ToolWindowButtonActiveGlyphKey}}"/>
      <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="ToolTipService.ShowDuration" Value="10000"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2" SnapsToDevicePixels="True">
          <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource {x:Static shell:VsBrushes.ToolWindowButtonHoverActiveGlyphKey}}"/><Setter TargetName="Surface" Property="Background" Value="{DynamicResource {x:Static shell:VsBrushes.ToolWindowButtonHoverActiveKey}}"/><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource {x:Static shell:VsBrushes.ToolWindowButtonHoverActiveBorderKey}}"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter Property="Foreground" Value="{DynamicResource {x:Static shell:VsBrushes.ToolWindowButtonDownActiveGlyphKey}}"/><Setter TargetName="Surface" Property="Background" Value="{DynamicResource {x:Static shell:VsBrushes.ToolWindowButtonDownKey}}"/><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource {x:Static shell:VsBrushes.ToolWindowButtonDownBorderKey}}"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource {x:Static shell:VsBrushes.AccentLightKey}}"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource {x:Static shell:VsBrushes.ToolWindowButtonInactiveGlyphKey}}"/><Setter TargetName="Surface" Property="Background" Value="{DynamicResource {x:Static shell:VsBrushes.ToolWindowButtonInactiveKey}}"/><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource {x:Static shell:VsBrushes.ToolWindowButtonInactiveBorderKey}}"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="PrimaryIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
      <Setter Property="Foreground" Value="{DynamicResource {x:Static shell:VsBrushes.CommandBarTextSelectedKey}}"/>
      <Setter Property="Background" Value="{DynamicResource {x:Static shell:VsBrushes.CommandBarSelectedKey}}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource {x:Static shell:VsBrushes.CommandBarSelectedBorderKey}}"/>
    </Style>
    <Style x:Key="TextButton" TargetType="Button">
      <Setter Property="MinHeight" Value="28"/><Setter Property="Padding" Value="12,4"/><Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{DynamicResource {x:Static shell:VsBrushes.CommandBarTextActiveKey}}"/><Setter Property="Background" Value="{DynamicResource {x:Static shell:VsBrushes.CommandBarGradientKey}}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource {x:Static shell:VsBrushes.CommandBarBorderKey}}"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2"><ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource {x:Static shell:VsBrushes.CommandBarTextHoverKey}}"/><Setter TargetName="Surface" Property="Background" Value="{DynamicResource {x:Static shell:VsBrushes.CommandBarHoverKey}}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter Property="Foreground" Value="{DynamicResource {x:Static shell:VsBrushes.CommandBarTextSelectedKey}}"/><Setter TargetName="Surface" Property="Background" Value="{DynamicResource {x:Static shell:VsBrushes.CommandBarSelectedKey}}"/><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource {x:Static shell:VsBrushes.CommandBarSelectedBorderKey}}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource {x:Static shell:VsBrushes.AccentLightKey}}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource {x:Static shell:VsBrushes.GrayTextKey}}"/><Setter Property="Background" Value="{DynamicResource {x:Static shell:VsBrushes.ButtonFaceKey}}"/><Setter Property="BorderBrush" Value="{DynamicResource {x:Static shell:VsBrushes.ButtonShadowKey}}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="PrimaryTextButton" TargetType="Button" BasedOn="{StaticResource TextButton}"><Setter Property="Foreground" Value="{DynamicResource {x:Static shell:VsBrushes.CommandBarTextSelectedKey}}"/><Setter Property="Background" Value="{DynamicResource {x:Static shell:VsBrushes.CommandBarSelectedKey}}"/><Setter Property="BorderBrush" Value="{DynamicResource {x:Static shell:VsBrushes.CommandBarSelectedBorderKey}}"/></Style>
    <Style x:Key="ChevronToggle" TargetType="ToggleButton">
      <Setter Property="Width" Value="24"/><Setter Property="Height" Value="24"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton"><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource {x:Static shell:VsBrushes.ToolWindowButtonHoverActiveKey}}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource {x:Static shell:VsBrushes.AccentLightKey}}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="MutedText" TargetType="TextBlock"><Setter Property="FontSize" Value="10.5"/><Setter Property="Opacity" Value="0.68"/></Style>
    <Style x:Key="ColumnHeader" TargetType="TextBlock"><Setter Property="FontSize" Value="10"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Opacity" Value="0.66"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
    <Style x:Key="SvnInput" TargetType="TextBox">
      <Setter Property="MinHeight" Value="26"/><Setter Property="Padding" Value="5,3"/>
      <Setter Property="Foreground" Value="{DynamicResource {x:Static shell:VsBrushes.ToolWindowTextKey}}"/>
      <Setter Property="Background" Value="{DynamicResource {x:Static shell:VsBrushes.ComboBoxBackgroundKey}}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource {x:Static shell:VsBrushes.ComboBoxBorderKey}}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="ManagementInput" TargetType="TextBox" BasedOn="{StaticResource SvnInput}">
      <Setter Property="MinHeight" Value="32"/><Setter Property="Padding" Value="8,6"/>
      <Setter Property="IsEnabled" Value="{Binding CanEditSvnManagement}"/>
    </Style>
    <Style x:Key="ManagementHelp" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/><Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Margin" Value="0,5,0,0"/><Setter Property="Opacity" Value="0.8"/>
    </Style>
    <Style x:Key="ManagementLabel" TargetType="Label">
      <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,16,0,6"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource {x:Static shell:VsBrushes.ToolWindowTextKey}}"/>
    </Style>
    <Style x:Key="ManagementTab" TargetType="TabItem">
      <Setter Property="Foreground" Value="{DynamicResource {x:Static shell:VsBrushes.ToolWindowTextKey}}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
        <Border x:Name="TabSurface" Padding="16,10" BorderThickness="0,0,0,2" BorderBrush="Transparent" Background="Transparent">
          <ContentPresenter x:Name="TabHeader" ContentSource="Header"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsSelected" Value="True"><Setter TargetName="TabHeader" Property="TextElement.FontWeight" Value="SemiBold"/><Setter TargetName="TabSurface" Property="BorderBrush" Value="{DynamicResource {x:Static shell:VsBrushes.AccentLightKey}}"/></Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource {x:Static shell:VsBrushes.CommandBarHoverKey}}"/></Trigger>
          <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource {x:Static shell:VsBrushes.CommandBarHoverKey}}"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="ManagementCombo" TargetType="ComboBox">
      <Setter Property="MinHeight" Value="32"/><Setter Property="Padding" Value="8,6"/>
      <Setter Property="Foreground" Value="{DynamicResource {x:Static shell:VsBrushes.ToolWindowTextKey}}"/>
      <Setter Property="Background" Value="{DynamicResource {x:Static shell:VsBrushes.ComboBoxBackgroundKey}}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource {x:Static shell:VsBrushes.ComboBoxBorderKey}}"/>
      <Setter Property="IsEnabled" Value="{Binding CanEditSvnManagement}"/>
      <Setter Property="ItemTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap"/></DataTemplate></Setter.Value></Setter>
      <Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static shell:VsBrushes.ToolWindowTextKey}}"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="ItemSurface" Padding="{TemplateBinding Padding}" Background="Transparent"><ContentPresenter/></Border>
          <ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="{DynamicResource {x:Static shell:VsBrushes.CommandBarHoverKey}}"/></Trigger></ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
      </Style></Setter.Value></Setter>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
        <Grid>
          <Border x:Name="ComboSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"/>
          <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"><Path Data="{StaticResource ChevronGeometry}" Width="10" Height="6" Stretch="Fill" StrokeThickness="1.5" Stroke="{DynamicResource {x:Static shell:VsBrushes.ToolWindowTextKey}}" HorizontalAlignment="Right" Margin="0,0,10,0"/></Border></ControlTemplate></ToggleButton.Template>
          </ToggleButton>
          <ContentPresenter x:Name="Selection" Margin="8,6,30,6" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" VerticalAlignment="Center"/>
          <TextBox x:Name="PART_EditableTextBox" Visibility="Collapsed" Margin="7,3,30,3" Padding="0" Background="Transparent" Foreground="{TemplateBinding Foreground}" BorderThickness="0" VerticalContentAlignment="Center">
            <TextBox.Template><ControlTemplate TargetType="TextBox"><ScrollViewer x:Name="PART_ContentHost" Focusable="False"/></ControlTemplate></TextBox.Template>
          </TextBox>
          <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False">
            <Border Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="240" Background="{DynamicResource {x:Static shell:VsBrushes.ComboBoxBackgroundKey}}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
              <ScrollViewer CanContentScroll="True" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
            </Border>
          </Popup>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsEditable" Value="True"><Setter TargetName="Selection" Property="Visibility" Value="Collapsed"/><Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/></Trigger>
          <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="ComboSurface" Property="BorderBrush" Value="{DynamicResource {x:Static shell:VsBrushes.AccentLightKey}}"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ComboSurface" Property="Opacity" Value="0.6"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Grid.Row="0" Height="40" Padding="10,0" Background="{DynamicResource {x:Static shell:VsBrushes.CommandBarGradientKey}}" BorderBrush="{DynamicResource {x:Static shell:VsBrushes.CommandBarBorderKey}}" BorderThickness="0,0,0,1">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Style="{StaticResource IconButton}" Command="{Binding NewSvnConnectionCommand}" ToolTip="로컬 저장소에 SVN 추적 경로 연결" AutomationProperties.Name="SVN 저장소 새 연결" Margin="0,0,2,0"><Path Data="{StaticResource RepositoryGeometry}" Stretch="Uniform" StrokeThickness="1.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Button>
          <Button Style="{StaticResource TextButton}" MinHeight="26" Padding="8,2" Content="로그 보기" Command="{Binding ShowLogCommand}" ToolTip="Visual Studio 출력 창에서 Git-SVN Shuttle 로그 보기" AutomationProperties.Name="Git-SVN Shuttle 로그 보기" Margin="0,0,6,0"/>
          <Button Style="{StaticResource IconButton}" Command="{Binding ToggleRuntimeSettingsCommand}" ToolTip="Git-SVN 실행 환경 설정" AutomationProperties.Name="Git-SVN 실행 환경 설정" Margin="0,0,2,0"><Path Data="{StaticResource SettingsGeometry}" Stretch="Uniform" StrokeThickness="1.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Button>
          <Button Style="{StaticResource IconButton}" Command="{Binding RefreshCommand}" ToolTip="저장소 상태 새로 고침" AutomationProperties.Name="저장소 상태 새로 고침" Margin="0,0,2,0"><Path Data="{StaticResource RefreshGeometry}" Stretch="Uniform" StrokeThickness="1.7" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Button>
          <Button Style="{StaticResource IconButton}" Command="{Binding CancelOperationCommand}" Visibility="{Binding CancelOperationVisibility}" ToolTip="현재 Git-SVN 작업 취소" AutomationProperties.Name="현재 Git-SVN 작업 취소" Margin="0,0,2,0"><Path Data="{StaticResource StopGeometry}" Stretch="Uniform" StrokeThickness="1.6" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Button>
          <Border Width="1" Height="18" Margin="5,0,7,0" Background="{DynamicResource {x:Static shell:VsBrushes.CommandBarToolBarSeparatorKey}}"/>
          <Button Style="{StaticResource IconButton}" Command="{Binding RebaseAllCommand}" ToolTip="모든 저장소에서 SVN 변경 받기" AutomationProperties.Name="모든 저장소에서 SVN 변경 받기" Margin="0,0,2,0"><Path Data="{StaticResource DownloadGeometry}" Stretch="Uniform" StrokeThickness="1.8" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Button>
          <Button Style="{StaticResource PrimaryIconButton}" Width="44" Padding="5,4" Command="{Binding DcommitAllCommand}" ToolTip="{Binding TopPublishSelectionActionName}" AutomationProperties.Name="{Binding TopPublishSelectionActionName}"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Path Width="15" Height="15" Data="{StaticResource UploadGeometry}" Stretch="Uniform" StrokeThickness="1.8" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/><TextBlock Text="{Binding SelectedRepositoryCount}" Visibility="{Binding SelectionBadgeVisibility}" Margin="5,0,0,0" FontSize="10" FontWeight="SemiBold" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center"/></StackPanel></Button>
        </StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="Git-SVN" FontWeight="SemiBold" Margin="0,0,12,0"/><TextBlock Text="{Binding RepositoryCount}" FontWeight="SemiBold"/><TextBlock Text=" 저장소" Opacity="0.68"/><TextBlock Text="  ·  " Opacity="0.4"/><TextBlock Text="{Binding TotalPendingCommits}" FontWeight="SemiBold" Foreground="{DynamicResource {x:Static shell:VsBrushes.AccentLightKey}}"/><TextBlock Text=" 커밋 대기" Opacity="0.68"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <Border Grid.Row="1" Visibility="{Binding RuntimePanelVisibility}" Padding="12,9" Background="{DynamicResource {x:Static shell:VsBrushes.CommandBarGradientBeginKey}}" BorderBrush="{DynamicResource {x:Static shell:VsBrushes.ToolWindowBorderKey}}" BorderThickness="0,0,0,1">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Grid Grid.Column="0" Width="16" Height="16" VerticalAlignment="Top" Margin="0,1,0,0"><Path Data="{StaticResource CheckGeometry}" Visibility="{Binding RuntimeReadyVisibility}" Stretch="Uniform" StrokeThickness="2" Stroke="{DynamicResource {x:Static shell:VsBrushes.AccentLightKey}}"/><Path Data="{StaticResource WarningGeometry}" Visibility="{Binding RuntimeWarningVisibility}" Stretch="Uniform" StrokeThickness="1.7" Stroke="{DynamicResource {x:Static shell:VsBrushes.InfoTextKey}}"/></Grid>
        <StackPanel Grid.Column="1" Margin="2,0,12,0"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding RuntimeTitle}" FontWeight="SemiBold"/><TextBlock Text="{Binding RuntimeVersion}" Style="{StaticResource MutedText}" Margin="8,1,0,0"/></StackPanel><TextBlock Text="{Binding RuntimeMessage}" Style="{StaticResource MutedText}" Margin="0,2,0,0"/><TextBlock Text="{Binding RuntimePath}" Visibility="{Binding RuntimePathVisibility}" ToolTip="{Binding RuntimePath}" FontFamily="Consolas" FontSize="10" Opacity="0.68" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/></StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Style="{StaticResource IconButton}" Command="{Binding ChooseGitExecutableCommand}" ToolTip="Git 실행 파일 직접 선택" AutomationProperties.Name="Git 실행 파일 직접 선택" Margin="0,0,2,0"><Path Data="{StaticResource FolderGeometry}" Stretch="Uniform" StrokeThickness="1.6" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Button>
          <Button Style="{StaticResource IconButton}" Command="{Binding AutoDetectRuntimeCommand}" ToolTip="사용 가능한 Git-SVN 자동 검색" AutomationProperties.Name="사용 가능한 Git-SVN 자동 검색" Margin="0,0,2,0"><Path Data="{StaticResource SearchGeometry}" Stretch="Uniform" StrokeThickness="1.6" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Button>
          <Button Style="{StaticResource IconButton}" Command="{Binding RecheckRuntimeCommand}" ToolTip="현재 Git 실행 경로 다시 검사" AutomationProperties.Name="현재 Git 실행 경로 다시 검사" Margin="0,0,2,0"><Path Data="{StaticResource RefreshGeometry}" Stretch="Uniform" StrokeThickness="1.7" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Button>
          <Button Style="{StaticResource IconButton}" Command="{Binding ResetRuntimeCommand}" ToolTip="Git 실행 경로를 기본값으로 재설정" AutomationProperties.Name="Git 실행 경로를 기본값으로 재설정"><Path Data="{StaticResource ResetGeometry}" Stretch="Uniform" StrokeThickness="1.6" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Button>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="2" Visibility="{Binding WorkspaceVisibility}">
      <Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="*"/></Grid.RowDefinitions>

      <Border Grid.Row="0" Padding="10,0" Background="{DynamicResource {x:Static shell:VsBrushes.CommandBarGradientBeginKey}}" BorderBrush="{DynamicResource {x:Static shell:VsBrushes.ToolWindowBorderKey}}" BorderThickness="0,0,0,1">
        <DockPanel LastChildFill="True">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Style="{StaticResource IconButton}" Width="26" Height="26" Command="{Binding ClearSelectionCommand}" ToolTip="현재 게시 선택 해제" AutomationProperties.Name="현재 게시 선택 해제" Margin="0,0,2,0"><Path Data="{StaticResource CloseGeometry}" Stretch="Uniform" StrokeThickness="1.8" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Button>
            <Button Style="{StaticResource PrimaryIconButton}" Width="26" Height="26" Command="{Binding DcommitAllCommand}" ToolTip="{Binding SummaryPublishSelectionActionName}" AutomationProperties.Name="{Binding SummaryPublishSelectionActionName}"><Path Data="{StaticResource UploadGeometry}" Stretch="Uniform" StrokeThickness="1.8" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Button>
          </StackPanel>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><CheckBox IsThreeState="True" IsChecked="{Binding AllSelectionState, Mode=OneWay}" Command="{Binding ToggleAllSelectionCommand}" ToolTip="게시 가능한 저장소 전체 선택 또는 해제" AutomationProperties.Name="게시 가능한 저장소 전체 선택"/><TextBlock Text="{Binding SelectionSummary}" Margin="8,0,0,0" FontSize="11" FontWeight="SemiBold"/></StackPanel>
        </DockPanel>
      </Border>

      <Border Grid.Row="1" Visibility="{Binding EmptyStateVisibility}" Padding="16" VerticalAlignment="Top"><StackPanel><TextBlock Text="Git-SVN 저장소가 없습니다." FontWeight="SemiBold"/><TextBlock Text="Git-SVN 솔루션을 연 다음 새로 고침을 누르세요." Style="{StaticResource MutedText}" Margin="0,4,0,0"/></StackPanel></Border>

      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <Border Height="28" Padding="8,0" Background="{DynamicResource {x:Static shell:VsBrushes.CommandBarGradientKey}}" BorderBrush="{DynamicResource {x:Static shell:VsBrushes.ToolWindowBorderKey}}" BorderThickness="0,0,0,1">
            <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding IsCompactLayout, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="26"/><ColumnDefinition Width="2*" MinWidth="170"/><ColumnDefinition Width="118"/><ColumnDefinition Width="68"/><ColumnDefinition Width="*" MinWidth="140"/><ColumnDefinition Width="64"/></Grid.ColumnDefinitions>
              <TextBlock Grid.Column="2" Text="저장소" Style="{StaticResource ColumnHeader}"/><TextBlock Grid.Column="3" Text="현재 상태" Style="{StaticResource ColumnHeader}"/><TextBlock Grid.Column="4" Text="게시 대기" Style="{StaticResource ColumnHeader}"/><TextBlock Grid.Column="5" Text="SVN 대상" Style="{StaticResource ColumnHeader}"/><TextBlock Grid.Column="6" Text="개별 작업" Style="{StaticResource ColumnHeader}" HorizontalAlignment="Center"/>
            </Grid>
          </Border>

          <ItemsControl ItemsSource="{Binding Repositories}">
            <ItemsControl.ItemTemplate><DataTemplate>
              <Border BorderBrush="{DynamicResource {x:Static shell:VsBrushes.ToolWindowBorderKey}}" BorderThickness="0,0,0,1" SnapsToDevicePixels="True">
                <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="Transparent"/><Style.Triggers><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="Background" Value="{DynamicResource {x:Static shell:VsBrushes.ComboBoxMouseOverBackgroundBeginKey}}"/></DataTrigger></Style.Triggers></Style></Border.Style>
                <StackPanel>
                  <Button Style="{StaticResource TextButton}" Content="SVN 연결 관리" Command="{Binding ManageSvnCommand}" HorizontalAlignment="Right" MinHeight="24" Padding="8,2" Margin="8,4,10,0" ToolTip="SVN 연결 설정과 새 작업 브랜치 만들기" AutomationProperties.Name="저장소 SVN 연결 관리"/>
                  <!-- Wide: a flat, dense table row. -->
                  <Grid MinHeight="54" Margin="8,0" MouseLeftButtonUp="OnRepositorySummaryMouseLeftButtonUp">
                    <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding IsCompactLayout, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Grid.Style>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="26"/><ColumnDefinition Width="2*" MinWidth="170"/><ColumnDefinition Width="118"/><ColumnDefinition Width="68"/><ColumnDefinition Width="*" MinWidth="140"/><ColumnDefinition Width="64"/></Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding CanSelect}" ToolTip="{Binding SelectionAutomationName}" AutomationProperties.Name="{Binding SelectionAutomationName}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <ToggleButton Grid.Column="1" Style="{StaticResource ChevronToggle}" IsChecked="{Binding IsExpanded, Mode=TwoWay}" Visibility="{Binding ExpandToggleVisibility}" ToolTip="{Binding CommitDetailsAutomationName}" AutomationProperties.Name="{Binding CommitDetailsAutomationName}">
                      <Path Width="11" Height="8" Data="{StaticResource ChevronGeometry}" Stretch="Uniform" StrokeThickness="1.6" Stroke="{DynamicResource {x:Static shell:VsBrushes.ToolWindowTextKey}}" RenderTransformOrigin="0.5,0.5"><Path.Style><Style TargetType="Path"><Setter Property="RenderTransform"><Setter.Value><RotateTransform Angle="-90"/></Setter.Value></Setter><Style.Triggers><DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True"><Setter Property="RenderTransform"><Setter.Value><RotateTransform Angle="0"/></Setter.Value></Setter></DataTrigger></Style.Triggers></Style></Path.Style></Path>
                    </ToggleButton>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="4,0,12,0"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="  ↗" Visibility="{Binding ExternalLinkVisibility}" FontSize="10" Foreground="{DynamicResource {x:Static shell:VsBrushes.AccentLightKey}}" ToolTip="외부 링크 저장소"/></StackPanel><TextBlock Text="{Binding PathText}" ToolTip="{Binding PathText}" FontFamily="Consolas" FontSize="10" Opacity="0.64" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/><TextBlock Text="{Binding LinkedProjectPathText}" ToolTip="{Binding LinkedProjectPathText}" Visibility="{Binding ExternalLinkVisibility}" FontFamily="Consolas" FontSize="9.5" Opacity="0.56" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/></StackPanel>
                    <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,0,10,0"><StackPanel Orientation="Horizontal"><ToggleButton Style="{StaticResource ChevronToggle}" Width="20" Height="20" Visibility="{Binding ProblemVisibility}" IsChecked="{Binding IsProblemExpanded, Mode=TwoWay}" ToolTip="{Binding ProblemAutomationName}" AutomationProperties.Name="{Binding ProblemAutomationName}"><Path Width="13" Height="13" Data="{StaticResource EyeGeometry}" Stretch="Uniform" StrokeThickness="1.5" Stroke="{DynamicResource {x:Static shell:VsBrushes.InfoTextKey}}"/></ToggleButton><TextBlock Text="{Binding StatusText}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayProblem}"/></StackPanel><Border Visibility="{Binding OperationOutcomeVisibility}" ToolTip="{Binding OperationOutcomeMessage}" AutomationProperties.Name="{Binding OperationOutcomeAutomationName}" Margin="0,3,0,0"><TextBlock Text="{Binding OperationOutcomeText}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource {x:Static shell:VsBrushes.AccentLightKey}}"/></Border></StackPanel>
                    <TextBlock Grid.Column="4" Text="{Binding PendingCountText}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0"><Path Width="12" Height="12" Data="{StaticResource ServerGeometry}" Stretch="Uniform" StrokeThickness="1.4" Stroke="{DynamicResource {x:Static shell:VsBrushes.AccentLightKey}}"/><TextBlock Text="{Binding SvnTargetText}" ToolTip="{Binding SvnTargetTooltip}" Margin="6,0,0,0" FontFamily="Consolas" FontSize="10" TextTrimming="CharacterEllipsis"/></StackPanel>
                    <StackPanel Grid.Column="6" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button Style="{StaticResource IconButton}" Command="{Binding RebaseCommand}" ToolTip="{Binding RebaseAutomationName}" AutomationProperties.Name="{Binding RebaseAutomationName}" Margin="0,0,2,0"><Path Data="{StaticResource DownloadGeometry}" Stretch="Uniform" StrokeThickness="1.8" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Button><Button Style="{StaticResource IconButton}" Command="{Binding DcommitCommand}" ToolTip="{Binding DcommitAutomationName}" AutomationProperties.Name="{Binding DcommitAutomationName}"><Path Data="{StaticResource UploadGeometry}" Stretch="Uniform" StrokeThickness="1.8" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Button></StackPanel>
                  </Grid>

                  <!-- Compact: identity/status first line, paths/target second line. -->
                  <Grid MinHeight="66" Margin="8,0" MouseLeftButtonUp="OnRepositorySummaryMouseLeftButtonUp">
                    <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsCompactLayout, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style>
                    <Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="24"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="26"/><ColumnDefinition Width="*" MinWidth="80"/><ColumnDefinition Width="92"/><ColumnDefinition Width="42"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding CanSelect}" ToolTip="{Binding SelectionAutomationName}" AutomationProperties.Name="{Binding SelectionAutomationName}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <ToggleButton Grid.Column="1" Style="{StaticResource ChevronToggle}" IsChecked="{Binding IsExpanded, Mode=TwoWay}" Visibility="{Binding ExpandToggleVisibility}" ToolTip="{Binding CommitDetailsAutomationName}" AutomationProperties.Name="{Binding CommitDetailsAutomationName}"><Path Width="11" Height="8" Data="{StaticResource ChevronGeometry}" Stretch="Uniform" StrokeThickness="1.6" Stroke="{DynamicResource {x:Static shell:VsBrushes.ToolWindowTextKey}}" RenderTransformOrigin="0.5,0.5"><Path.Style><Style TargetType="Path"><Setter Property="RenderTransform"><Setter.Value><RotateTransform Angle="-90"/></Setter.Value></Setter><Style.Triggers><DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True"><Setter Property="RenderTransform"><Setter.Value><RotateTransform Angle="0"/></Setter.Value></Setter></DataTrigger></Style.Triggers></Style></Path.Style></Path></ToggleButton>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,6,0"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text=" ↗" Visibility="{Binding ExternalLinkVisibility}" FontSize="10" Foreground="{DynamicResource {x:Static shell:VsBrushes.AccentLightKey}}"/></StackPanel>
                    <StackPanel Grid.Column="3" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><ToggleButton Style="{StaticResource ChevronToggle}" Width="20" Height="20" Visibility="{Binding ProblemVisibility}" IsChecked="{Binding IsProblemExpanded, Mode=TwoWay}" ToolTip="{Binding ProblemAutomationName}" AutomationProperties.Name="{Binding ProblemAutomationName}"><Path Width="12" Height="12" Data="{StaticResource EyeGeometry}" Stretch="Uniform" StrokeThickness="1.5" Stroke="{DynamicResource {x:Static shell:VsBrushes.InfoTextKey}}"/></ToggleButton><TextBlock Text="{Binding StatusText}" FontSize="10.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayProblem}"/></StackPanel><Border Visibility="{Binding OperationOutcomeVisibility}" ToolTip="{Binding OperationOutcomeMessage}" AutomationProperties.Name="{Binding OperationOutcomeAutomationName}"><TextBlock Text="{Binding OperationOutcomeText}" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource {x:Static shell:VsBrushes.AccentLightKey}}"/></Border></StackPanel>
                    <TextBlock Grid.Column="4" Text="{Binding PendingCountText}" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button Style="{StaticResource IconButton}" Width="27" Height="27" Command="{Binding RebaseCommand}" ToolTip="{Binding RebaseAutomationName}" AutomationProperties.Name="{Binding RebaseAutomationName}" Margin="0,0,2,0"><Path Data="{StaticResource DownloadGeometry}" Stretch="Uniform" StrokeThickness="1.8" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Button><Button Style="{StaticResource IconButton}" Width="27" Height="27" Command="{Binding DcommitCommand}" ToolTip="{Binding DcommitAutomationName}" AutomationProperties.Name="{Binding DcommitAutomationName}"><Path Data="{StaticResource UploadGeometry}" Stretch="Uniform" StrokeThickness="1.8" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Button></StackPanel>
                    <Grid Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="4" Margin="4,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding CompactPathText}" ToolTip="{Binding CompactPathText}" FontFamily="Consolas" FontSize="9.5" Opacity="0.6" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/><TextBlock Grid.Column="1" Text="{Binding SvnTargetText}" ToolTip="{Binding SvnTargetTooltip}" FontFamily="Consolas" FontSize="9.5" Opacity="0.7" TextTrimming="CharacterEllipsis"/></Grid>
                  </Grid>

                  <Border Visibility="{Binding OperationOutcomeVisibility}" Padding="60,7,12,8" Background="{DynamicResource {x:Static shell:VsBrushes.CommandBarGradientBeginKey}}" BorderBrush="{DynamicResource {x:Static shell:VsBrushes.ToolWindowBorderKey}}" BorderThickness="0,1,0,0" AutomationProperties.Name="{Binding OperationOutcomeAutomationName}">
                    <StackPanel><TextBlock Text="{Binding OperationOutcomeText}" FontSize="10.5" FontWeight="SemiBold"/><TextBlock Text="{Binding OperationOutcomeMessage}" Margin="0,2,0,0" FontSize="10.5" TextWrapping="Wrap"/></StackPanel>
                  </Border>

                  <Border Visibility="{Binding ProblemDetailsVisibility}" Padding="60,8,12,10" Background="{DynamicResource {x:Static shell:VsBrushes.InfoBackgroundKey}}" BorderBrush="{DynamicResource {x:Static shell:VsBrushes.ToolWindowBorderKey}}" BorderThickness="0,1,0,0">
                    <StackPanel><TextBlock Text="{Binding DisplayProblem}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource {x:Static shell:VsBrushes.InfoTextKey}}"/><StackPanel Visibility="{Binding ConflictFilesVisibility}" Margin="0,6,0,0"><TextBlock Text="해결할 충돌 파일" FontSize="10" FontWeight="SemiBold"/><ItemsControl ItemsSource="{Binding ConflictedFiles}" Margin="8,2,0,0"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="10"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel><StackPanel Visibility="{Binding RebaseRecoveryVisibility}" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0"><Button Style="{StaticResource TextButton}" Content="rebase 중단" Command="{Binding AbortRebaseCommand}" Margin="0,0,6,0"/><Button Style="{StaticResource PrimaryTextButton}" Content="rebase 계속" Command="{Binding ContinueRebaseCommand}"/></StackPanel></StackPanel>
                  </Border>

                  <Border Visibility="{Binding CommitDetailsVisibility}" Padding="60,7,12,9" Background="{DynamicResource {x:Static shell:VsBrushes.CommandBarGradientBeginKey}}" BorderBrush="{DynamicResource {x:Static shell:VsBrushes.ToolWindowBorderKey}}" BorderThickness="0,1,0,0">
                    <StackPanel>
                      <Grid Height="20"><Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions><TextBlock Text="해시" Style="{StaticResource ColumnHeader}"/><TextBlock Grid.Column="1" Text="제목" Style="{StaticResource ColumnHeader}"/><TextBlock Grid.Column="2" Text="작성자" Style="{StaticResource ColumnHeader}"/><TextBlock Grid.Column="3" Text="날짜" Style="{StaticResource ColumnHeader}"/></Grid>
                      <ItemsControl ItemsSource="{Binding PendingCommits}"><ItemsControl.ItemTemplate><DataTemplate><Grid MinHeight="28"><Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions><TextBlock Text="{Binding ShortHash}" FontFamily="Consolas" FontSize="10" VerticalAlignment="Center" Foreground="{DynamicResource {x:Static shell:VsBrushes.AccentLightKey}}"/><TextBlock Grid.Column="1" Text="{Binding Subject}" FontSize="10.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/><TextBlock Grid.Column="2" Text="{Binding Author}" FontSize="10" Opacity="0.68" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="3" Text="{Binding Date}" FontSize="10" Opacity="0.68" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><Border Grid.ColumnSpan="4" Height="1" VerticalAlignment="Bottom" Opacity="0.5" Background="{DynamicResource {x:Static shell:VsBrushes.ToolWindowBorderKey}}"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </Border>
            </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
    </Grid>
    <Border Grid.Row="3" Height="24" Padding="10,0" Background="{DynamicResource {x:Static shell:VsBrushes.CommandBarGradientKey}}" BorderBrush="{DynamicResource {x:Static shell:VsBrushes.CommandBarBorderKey}}" BorderThickness="0,1,0,0">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding StatusText}" FontSize="10.5" Opacity="0.76" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><ProgressBar Grid.Column="1" Width="64" Height="2" IsIndeterminate="True" Visibility="{Binding BusyVisibility}" Margin="10,0,0,0" VerticalAlignment="Center"/></Grid>
    </Border>

    <Grid x:Name="PublishOverlay" Grid.RowSpan="4" Visibility="{Binding PublishConfirmationVisibility, FallbackValue=Collapsed, TargetNullValue=Collapsed}" Background="#99000000" MouseLeftButtonDown="OnPublishOverlayMouseLeftButtonDown">
      <Border MinWidth="360" MaxWidth="520" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource {x:Static shell:VsBrushes.ComboBoxBackgroundKey}}" BorderBrush="{DynamicResource {x:Static shell:VsBrushes.ToolWindowBorderKey}}" BorderThickness="1">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Border Padding="16,14" BorderBrush="{DynamicResource {x:Static shell:VsBrushes.ToolWindowBorderKey}}" BorderThickness="0,0,0,1"><StackPanel><TextBlock Text="SVN에 게시" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding PublishConfirmationSubtitle}" FontSize="11" Opacity="0.68" Margin="0,3,0,0"/></StackPanel></Border>
          <StackPanel Grid.Row="1" Margin="16,12,16,0">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8"><Path Width="13" Height="13" Data="{StaticResource ServerGeometry}" Stretch="Uniform" StrokeThickness="1.5" Stroke="{DynamicResource {x:Static shell:VsBrushes.AccentLightKey}}"/><TextBlock Text="{Binding PublishTargetSummary}" FontFamily="Consolas" FontSize="10.5" Margin="7,0,0,0" TextWrapping="Wrap"/></StackPanel>
            <ItemsControl ItemsSource="{Binding PendingPublishItems}"><ItemsControl.ItemTemplate><DataTemplate><Grid MinHeight="40"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding RepositoryName}" FontSize="11" FontWeight="SemiBold"/><TextBlock Text="{Binding Subject}" FontSize="10.5" Opacity="0.72" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding ShortHash}" FontFamily="Consolas" FontSize="10" Foreground="{DynamicResource {x:Static shell:VsBrushes.AccentLightKey}}" Margin="12,0,0,0" VerticalAlignment="Center"/><Border Grid.ColumnSpan="2" Height="1" VerticalAlignment="Bottom" Background="{DynamicResource {x:Static shell:VsBrushes.ToolWindowBorderKey}}"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            <Border Margin="0,10,0,0" Padding="9,7" Background="{DynamicResource {x:Static shell:VsBrushes.InfoBackgroundKey}}"><TextBlock Text="저장소별 게시 작업은 하나의 트랜잭션이 아닙니다. 앞 저장소가 성공한 뒤 다음 저장소가 실패할 수 있습니다." TextWrapping="Wrap" FontSize="10.5" Foreground="{DynamicResource {x:Static shell:VsBrushes.InfoTextKey}}"/></Border>
          </StackPanel>
          <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="16,14,16,16"><Button Style="{StaticResource TextButton}" Content="취소" Command="{Binding CancelPublishCommand}" Margin="0,0,6,0"/><Button Style="{StaticResource PrimaryTextButton}" Content="게시 시작" Command="{Binding ConfirmPublishCommand}"/></StackPanel>
        </Grid>
      </Border>
    </Grid>

    <Grid Grid.RowSpan="4" Visibility="{Binding SvnManagementVisibility, FallbackValue=Collapsed, TargetNullValue=Collapsed}" Background="#99000000">
      <Border MinWidth="360" MaxWidth="680" Margin="12" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{DynamicResource {x:Static shell:VsBrushes.ToolWindowBackgroundKey}}" BorderBrush="{DynamicResource {x:Static shell:VsBrushes.ToolWindowBorderKey}}" BorderThickness="1">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Border Padding="20,16" BorderBrush="{DynamicResource {x:Static shell:VsBrushes.ToolWindowBorderKey}}" BorderThickness="0,0,0,1">
            <StackPanel>
              <TextBlock Text="SVN 연결 관리" FontSize="18" FontWeight="SemiBold"/>
              <TextBlock Text="{Binding ManagementRepositoryPath}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ManagementRepositoryPath}" Margin="0,6,0,0" FontSize="12"/>
            </StackPanel>
          </Border>
          <Border Grid.Row="1" Padding="20,12" Visibility="{Binding BusyVisibility}" Background="{DynamicResource {x:Static shell:VsBrushes.InfoBackgroundKey}}">
            <StackPanel>
              <TextBlock Text="{Binding ManagementProgressText}" Foreground="{DynamicResource {x:Static shell:VsBrushes.InfoTextKey}}" TextWrapping="Wrap" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite"/>
              <ProgressBar Height="3" IsIndeterminate="True" Margin="0,10,0,0" Foreground="{DynamicResource {x:Static shell:VsBrushes.AccentLightKey}}" AutomationProperties.Name="SVN 작업 진행 중"/>
            </StackPanel>
          </Border>
          <Border Grid.Row="2" Visibility="{Binding ManagementFeedbackVisibility}" Padding="20,12" Background="{DynamicResource {x:Static shell:VsBrushes.InfoBackgroundKey}}">
            <StackPanel DataContext="{Binding ManagementFeedback}" TextElement.Foreground="{DynamicResource {x:Static shell:VsBrushes.InfoTextKey}}">
              <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
              <TextBlock Text="{Binding NextAction}" Style="{StaticResource ManagementHelp}"/>
              <Button Content="연결 다시 확인" Command="{Binding DataContext.RefreshDcommitTargetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" HorizontalAlignment="Left" Margin="0,10,0,0">
                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource TextButton}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding CanRetryQuery}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style>
              </Button>
              <Expander Header="결과 상세" Margin="0,8,0,0" Foreground="{DynamicResource {x:Static shell:VsBrushes.InfoTextKey}}">
                <Expander.Style><Style TargetType="Expander"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasDetails}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Expander.Style>
                <TextBox Text="{Binding Details, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="120" VerticalScrollBarVisibility="Auto" Background="Transparent" Foreground="{DynamicResource {x:Static shell:VsBrushes.InfoTextKey}}" BorderThickness="0" Margin="0,8,0,0" AutomationProperties.Name="작업 결과 상세"/>
              </Expander>
            </StackPanel>
          </Border>
            <TabControl Grid.Row="3" SelectedIndex="{Binding ManagementTabIndex}" Margin="20,4,20,16" ItemContainerStyle="{StaticResource ManagementTab}" Background="Transparent" BorderThickness="0">
              <TabControl.Template><ControlTemplate TargetType="TabControl">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                  <TabPanel IsItemsHost="True" KeyboardNavigation.TabIndex="0"/>
                  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ContentPresenter ContentSource="SelectedContent" Margin="0,4,0,0"/></ScrollViewer>
                </Grid>
              </ControlTemplate></TabControl.Template>
              <TabItem Header="새 브랜치">
                <StackPanel>
                  <TextBlock Text="SVN 서버의 원본을 복사해 새 작업 브랜치를 만듭니다." Style="{StaticResource ManagementHelp}" Margin="0,12,0,0"/>
                  <Label Content="복사할 원본" Target="{Binding ElementName=BranchSourceInput}" Style="{StaticResource ManagementLabel}"/>
                  <ComboBox x:Name="BranchSourceInput" Style="{StaticResource ManagementCombo}" IsEditable="True" StaysOpenOnEdit="True" ItemsSource="{Binding BranchForm.SourceChoices}" Text="{Binding BranchForm.SourcePath, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding BranchForm.SourceUrl}" AutomationProperties.Name="복사할 원본 SVN 경로"/>
                  <TextBlock Text="목록에서 선택하거나 SVN 경로를 입력할 수 있습니다." Style="{StaticResource ManagementHelp}"/>
                  <Label Content="새 브랜치 이름" Target="{Binding ElementName=BranchNameInput}" Style="{StaticResource ManagementLabel}"/>
                  <TextBox x:Name="BranchNameInput" Style="{StaticResource ManagementInput}" Text="{Binding BranchForm.Name, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="새 SVN 브랜치 이름"/>
                  <TextBlock Text="예: fix-login 또는 release-2026" Style="{StaticResource ManagementHelp}"/>
                  <Label Content="저장 위치" Target="{Binding ElementName=BranchDestinationInput}" Style="{StaticResource ManagementLabel}"/>
                  <ComboBox x:Name="BranchDestinationInput" Style="{StaticResource ManagementCombo}" IsEditable="True" StaysOpenOnEdit="True" ItemsSource="{Binding BranchForm.DestinationChoices}" Text="{Binding BranchForm.DestinationPath, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="새 SVN 브랜치를 넣을 폴더"/>
                  <TextBlock Text="새 브랜치를 넣을 폴더입니다. 후보가 여러 개면 선택하세요." Style="{StaticResource ManagementHelp}"/>
                  <Border BorderBrush="{DynamicResource {x:Static shell:VsBrushes.ToolWindowBorderKey}}" BorderThickness="0,1,0,1" Padding="0,12" Margin="0,20,0,0">
                    <StackPanel>
                      <TextBlock Text="생성 결과 미리보기" FontWeight="SemiBold"/>
                      <TextBlock Text="{Binding BranchForm.DestinationUrl}" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource {x:Static shell:VsBrushes.AccentLightKey}}" AutomationProperties.Name="생성될 SVN 브랜치 주소"/>
                      <TextBlock Text="{Binding BranchForm.RevisionSummary, StringFormat=복사할 버전: {0}}" Style="{StaticResource ManagementHelp}"/>
                      <TextBlock Text="{Binding BranchForm.LocalName, StringFormat=로컬 Git 브랜치: {0}}" Style="{StaticResource ManagementHelp}"/>
                      <TextBlock Text="{Binding BranchForm.SwitchSummary}" Style="{StaticResource ManagementHelp}"/>
                    </StackPanel>
                  </Border>
                  <Expander x:Name="BranchAdvancedSettings" Header="고급 설정" Margin="0,16,0,0" Foreground="{DynamicResource {x:Static shell:VsBrushes.ToolWindowTextKey}}">
                    <StackPanel Margin="0,0,0,4">
                      <Label Content="복사할 버전" Target="{Binding ElementName=BranchRevisionInput}" Style="{StaticResource ManagementLabel}"/>
                      <TextBox x:Name="BranchRevisionInput" Style="{StaticResource ManagementInput}" Text="{Binding BranchForm.Revision, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="브랜치 기준 SVN 리비전"/>
                      <TextBlock Text="HEAD는 서버의 최신 버전입니다. 과거 버전에서 만들려면 리비전 번호를 입력하세요." Style="{StaticResource ManagementHelp}"/>
                      <Label Content="생성 기록에 남길 메시지" Target="{Binding ElementName=BranchMessageInput}" Style="{StaticResource ManagementLabel}"/>
                      <TextBox x:Name="BranchMessageInput" Style="{StaticResource ManagementInput}" MinHeight="60" AcceptsReturn="True" Text="{Binding BranchForm.Message, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="SVN 브랜치 생성 커밋 메시지"/>
                      <Label Content="로컬 Git 브랜치 이름" Target="{Binding ElementName=LocalBranchInput}" Style="{StaticResource ManagementLabel}"/>
                      <TextBox x:Name="LocalBranchInput" Style="{StaticResource ManagementInput}" Text="{Binding BranchForm.LocalName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="연결할 로컬 Git 브랜치 이름"/>
                      <TextBlock Text="기본값은 새 SVN 브랜치 이름입니다. Git에서 사용할 수 없는 문자는 바꿉니다. 이름이나 메시지를 비우면 자동값을 다시 사용합니다." Style="{StaticResource ManagementHelp}"/>
                      <CheckBox Content="생성 후 이 브랜치로 전환" IsChecked="{Binding BranchForm.SwitchAfterCreate}" IsEnabled="{Binding CanEditSvnManagement}" Margin="0,16,0,0"/>
                      <TextBlock Text="현재 파일을 그대로 두려면 전환을 끄세요. 새 로컬 브랜치는 준비됩니다." Style="{StaticResource ManagementHelp}"/>
                    </StackPanel>
                  </Expander>
                  <TextBlock Text="SVN 서버에 브랜치를 만든 뒤 이력을 가져와 로컬 Git 브랜치를 연결합니다." Style="{StaticResource ManagementHelp}" Margin="0,10,0,0"/>
                </StackPanel>
              </TabItem>
              <TabItem Header="연결 설정">
                <StackPanel>
                  <Label Content="로컬 저장소 폴더" Target="{Binding ElementName=ManagementRepositoryInput}" Style="{StaticResource ManagementLabel}"/>
                  <TextBox x:Name="ManagementRepositoryInput" Style="{StaticResource ManagementInput}" Text="{Binding ManagementRepositoryPath, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="로컬 저장소 폴더"/>
                  <Button Style="{StaticResource TextButton}" Content="설정 다시 조회" Command="{Binding LoadTrackingPathsCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                  <Label Content="SVN 기준 주소" Target="{Binding ElementName=TrackingBaseInput}" Style="{StaticResource ManagementLabel}"/>
                  <TextBox x:Name="TrackingBaseInput" Style="{StaticResource ManagementInput}" Text="{Binding TrackingBaseUrl, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="SVN 기준 URL"/>
                  <TextBlock Text="예: https://svn.example.com/repos/ProjectA" Style="{StaticResource ManagementHelp}"/>
                  <Label Content="가져올 경로 구조" Target="{Binding ElementName=TrackingLayoutInput}" Style="{StaticResource ManagementLabel}"/>
                  <ComboBox x:Name="TrackingLayoutInput" Style="{StaticResource ManagementCombo}" SelectedIndex="{Binding TrackingLayoutIndex}" AutomationProperties.Name="SVN 경로 구조">
                    <ComboBoxItem Content="주소 아래의 trunk, branches, tags"/>
                    <ComboBoxItem Content="입력한 주소 하나만"/>
                    <ComboBoxItem Content="경로 직접 지정"/>
                  </ComboBox>
                  <TextBlock Text="프로젝트의 trunk나 브랜치 주소를 직접 입력했다면 ‘입력한 주소 하나만’을 선택하세요." Style="{StaticResource ManagementHelp}"/>
                  <Expander Header="고급 설정: 가져올 경로 편집" IsExpanded="{Binding IsTrackingAdvancedExpanded}" Margin="0,16,0,0" Foreground="{DynamicResource {x:Static shell:VsBrushes.ToolWindowTextKey}}">
                    <StackPanel>
                      <TextBlock Text="기준 주소에 상대적인 경로를 한 줄에 하나씩 입력하세요. 주소 자체는 '.'입니다. 기존 배치와 새 배치를 함께 가져올 수 있습니다." Style="{StaticResource ManagementHelp}" Margin="0,10,0,0"/>
                      <Label Content="trunk 경로" Target="{Binding ElementName=TrunkPathsInput}" Style="{StaticResource ManagementLabel}"/>
                      <TextBox x:Name="TrunkPathsInput" Style="{StaticResource ManagementInput}" MinHeight="54" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Text="{Binding TrunkPathsText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="trunk 추적 경로, 한 줄에 하나"/>
                      <Label Content="브랜치 폴더 또는 패턴" Target="{Binding ElementName=BranchesPathsInput}" Style="{StaticResource ManagementLabel}"/>
                      <TextBox x:Name="BranchesPathsInput" Style="{StaticResource ManagementInput}" MinHeight="54" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Text="{Binding BranchesPathsText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="branches 추적 경로, 한 줄에 하나"/>
                      <TextBlock Text="예: branches/ProjectA/* 또는 ProjectA/branches/*" Style="{StaticResource ManagementHelp}"/>
                      <Label Content="태그 폴더 또는 패턴" Target="{Binding ElementName=TagsPathsInput}" Style="{StaticResource ManagementLabel}"/>
                      <TextBox x:Name="TagsPathsInput" Style="{StaticResource ManagementInput}" MinHeight="54" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Text="{Binding TagsPathsText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="tags 추적 경로, 한 줄에 하나"/>
                    </StackPanel>
                  </Expander>
                  <TextBlock Text="연결 설정을 저장하고 이력을 가져옵니다. 기존 커밋과 작업 파일은 유지되며, 현재 Git 브랜치의 전송 대상은 바뀌지 않습니다." Style="{StaticResource ManagementHelp}" Margin="0,10,0,0"/>
                  <Border BorderBrush="{DynamicResource {x:Static shell:VsBrushes.ToolWindowBorderKey}}" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,20,0,0">
                    <StackPanel>
                      <TextBlock Text="현재 Git 브랜치의 SVN 전송 대상" FontWeight="SemiBold"/>
                      <TextBlock Text="{Binding ActualDcommitTarget}" TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
                      <TextBlock Text="{Binding DcommitTargetGuidance}" Style="{StaticResource ManagementHelp}"/>
                      <Button Style="{StaticResource TextButton}" Content="연결 다시 확인" Command="{Binding RefreshDcommitTargetCommand}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                      <Expander Header="연결 상세" Margin="0,12,0,0" Foreground="{DynamicResource {x:Static shell:VsBrushes.ToolWindowTextKey}}">
                        <StackPanel>
                          <TextBox Text="{Binding DcommitTargetDetails, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Background="Transparent" Foreground="{DynamicResource {x:Static shell:VsBrushes.ToolWindowTextKey}}" BorderThickness="0" Margin="0,8,0,0" AutomationProperties.Name="실제 dcommit 대상 상세"/>
                          <TextBlock Text="기존 이력과 작업 브랜치 연결" FontWeight="SemiBold" Margin="0,12,0,0"/>
                          <TextBlock Text="{Binding RetainedTrackingPathsText}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        </StackPanel>
                      </Expander>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </TabItem>
            </TabControl>
          <Border Grid.Row="4" BorderBrush="{DynamicResource {x:Static shell:VsBrushes.ToolWindowBorderKey}}" BorderThickness="0,1,0,0" Padding="20,12">
            <StackPanel>
            <TextBlock Text="{Binding BranchForm.ValidationMessage}" AutomationProperties.LiveSetting="Polite">
              <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource ManagementHelp}"><Setter Property="Margin" Value="0,0,0,10"/><Style.Triggers>
                <DataTrigger Binding="{Binding BranchForm.ValidationMessage}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                <DataTrigger Binding="{Binding ManagementTabIndex}" Value="1"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                <DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
              </Style.Triggers></Style></TextBlock.Style>
            </TextBlock>
            <DockPanel>
              <Button DockPanel.Dock="Left" Style="{StaticResource TextButton}" Content="로그 보기" Command="{Binding ShowLogCommand}" HorizontalAlignment="Left"/>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelManagementButton" Style="{StaticResource TextButton}" Content="작업 취소" Command="{Binding CancelOperationCommand}" Visibility="{Binding CancelOperationVisibility}" Margin="0,0,8,0"/>
                <Button x:Name="CreateBranchButton" Content="브랜치 만들기" Command="{Binding CreateSvnBranchCommand}" Margin="0,0,8,0">
                  <Button.Style><Style TargetType="Button" BasedOn="{StaticResource PrimaryTextButton}"><Style.Triggers><DataTrigger Binding="{Binding ManagementTabIndex}" Value="1"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style>
                </Button>
                <Button Content="SVN 이력 가져오기" Command="{Binding SaveTrackingPathsCommand}" Margin="0,0,8,0">
                  <Button.Style><Style TargetType="Button" BasedOn="{StaticResource PrimaryTextButton}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ManagementTabIndex}" Value="1"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style>
                </Button>
                <Button x:Name="CloseManagementButton" Style="{StaticResource TextButton}" Content="닫기" Command="{Binding CloseSvnManagementCommand}" ToolTip="진행 중인 작업은 계속됩니다. 중단하려면 작업 취소를 누르세요."/>
              </StackPanel>
            </DockPanel>
            </StackPanel>
          </Border>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
