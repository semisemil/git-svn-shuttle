<UserControl x:Class="GitSvnShuttle.Vsix.GitSvnShuttleControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
             MinWidth="420" MinHeight="280"
             PreviewKeyDown="OnPreviewKeyDown"
             Background="{DynamicResource {x:Static shell:VsBrushes.ToolWindowBackgroundKey}}"
             Foreground="{DynamicResource {x:Static shell:VsBrushes.ToolWindowTextKey}}">
  <UserControl.Resources>
    <Geometry x:Key="ChevronGeometry">M 3,5 L 8,10 13,5</Geometry>
    <Geometry x:Key="RefreshGeometry">M 16,5 L 16,1 12,1 M 16,1 A 7,7 0 0 0 4,5 M 4,13 L 4,17 8,17 M 4,17 A 7,7 0 0 0 16,13</Geometry>
    <Geometry x:Key="DownloadGeometry">M 10,2 L 10,13 M 5,9 L 10,14 15,9 M 3,18 L 17,18</Geometry>
    <Geometry x:Key="UploadGeometry">M 10,18 L 10,7 M 5,11 L 10,6 15,11 M 3,2 L 17,2</Geometry>
    <Geometry x:Key="RepositoryGeometry">M 4,2 L 16,2 16,18 5,18 C 3,18 3,16 3,15 L 3,4 C 3,3 4,2 5,2 M 7,2 L 7,18 M 9,6 L 14,6</Geometry>
    <Geometry x:Key="WarningGeometry">M 10,2 L 18,17 2,17 Z M 10,7 L 10,12 M 10,15 L 10,15.1</Geometry>
    <Geometry x:Key="ServerGeometry">M 3,2 L 17,2 17,8 3,8 Z M 3,12 L 17,12 17,18 3,18 Z M 6,5 L 6.1,5 M 6,15 L 6.1,15 M 10,5 L 14,5 M 10,15 L 14,15</Geometry>
    <Geometry x:Key="CheckGeometry">M 3,10 L 8,15 17,5</Geometry>
    <Geometry x:Key="CommitGeometry">M 2,10 L 7,10 M 13,10 L 18,10 M 13,10 A 3,3 0 1 1 7,10 A 3,3 0 1 1 13,10</Geometry>

    <Style x:Key="ModernButton" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource {x:Static shell:VsBrushes.ToolWindowTextKey}}" />
      <Setter Property="Background" Value="{DynamicResource {x:Static shell:VsBrushes.ComboBoxBackgroundKey}}" />
      <Setter Property="BorderBrush" Value="{DynamicResource {x:Static shell:VsBrushes.ComboBoxBorderKey}}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="ToolTipService.ShowDuration" Value="10000" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6"
                    SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}"
                                RecognizesAccessKey="True" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ButtonBorder" Property="Background"
                        Value="{DynamicResource {x:Static shell:VsBrushes.ComboBoxMouseOverBackgroundBeginKey}}" />
                <Setter TargetName="ButtonBorder" Property="BorderBrush"
                        Value="{DynamicResource {x:Static shell:VsBrushes.ComboBoxMouseOverBorderKey}}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ButtonBorder" Property="Background"
                        Value="{DynamicResource {x:Static shell:VsBrushes.ComboBoxMouseDownBackgroundKey}}" />
                <Setter TargetName="ButtonBorder" Property="BorderBrush"
                        Value="{DynamicResource {x:Static shell:VsBrushes.ComboBoxMouseDownBorderKey}}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground"
                        Value="{DynamicResource {x:Static shell:VsBrushes.ComboBoxDisabledGlyphKey}}" />
                <Setter TargetName="ButtonBorder" Property="Background"
                        Value="{DynamicResource {x:Static shell:VsBrushes.ComboBoxDisabledBackgroundKey}}" />
                <Setter TargetName="ButtonBorder" Property="BorderBrush"
                        Value="{DynamicResource {x:Static shell:VsBrushes.ComboBoxDisabledBorderKey}}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="36" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="8" />
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
      <Setter Property="Background" Value="{DynamicResource {x:Static shell:VsBrushes.AccentMediumKey}}" />
      <Setter Property="BorderBrush" Value="{DynamicResource {x:Static shell:VsBrushes.AccentBorderKey}}" />
      <Setter Property="Foreground" Value="{DynamicResource {x:Static shell:VsBrushes.HighlightTextKey}}" />
    </Style>

    <Style x:Key="PrimaryIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
      <Setter Property="Background" Value="{DynamicResource {x:Static shell:VsBrushes.AccentMediumKey}}" />
      <Setter Property="BorderBrush" Value="{DynamicResource {x:Static shell:VsBrushes.AccentBorderKey}}" />
      <Setter Property="Foreground" Value="{DynamicResource {x:Static shell:VsBrushes.HighlightTextKey}}" />
    </Style>

    <Style x:Key="ChevronToggle" TargetType="ToggleButton">
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource {x:Static shell:VsBrushes.ToolWindowTextKey}}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="ToggleBorder" Background="{TemplateBinding Background}" CornerRadius="4">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ToggleBorder" Property="Background"
                        Value="{DynamicResource {x:Static shell:VsBrushes.ToolWindowButtonHoverActiveKey}}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SecondaryText" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource {x:Static shell:VsBrushes.ToolWindowTextKey}}" />
      <Setter Property="FontSize" Value="11" />
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Padding="10,8"
            Background="{DynamicResource {x:Static shell:VsBrushes.CommandBarGradientKey}}"
            BorderThickness="0,0,0,1"
            BorderBrush="{DynamicResource {x:Static shell:VsBrushes.CommandBarBorderKey}}">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Style="{StaticResource IconButton}" Command="{Binding RefreshCommand}"
                  ToolTip="상태 새로 고침" Margin="0,0,8,0">
            <Path Data="{StaticResource RefreshGeometry}" Stretch="Uniform" StrokeThickness="1.7"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
          </Button>
          <Button Style="{StaticResource ModernButton}" Command="{Binding RebaseAllCommand}"
                  ToolTip="모든 저장소에서 SVN 변경 받기" Margin="0,0,8,0">
            <StackPanel Orientation="Horizontal">
              <Path Width="18" Height="18" Data="{StaticResource DownloadGeometry}" Stretch="Uniform"
                    StrokeThickness="1.8"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
              <TextBlock Text="모두 받기" Margin="7,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Style="{StaticResource PrimaryButton}" Command="{Binding DcommitAllCommand}"
                  ToolTip="게시할 커밋을 확인한 뒤 SVN에 게시">
            <StackPanel Orientation="Horizontal">
              <Path Width="18" Height="18" Data="{StaticResource UploadGeometry}" Stretch="Uniform"
                    StrokeThickness="1.8"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
              <TextBlock Text="SVN에 게시" Margin="7,0,0,0" VerticalAlignment="Center" />
              <Border MinWidth="20" Height="20" CornerRadius="10" Margin="7,0,0,0" Padding="5,0"
                      Background="{DynamicResource {x:Static shell:VsBrushes.HighlightTextKey}}">
                <TextBlock Text="{Binding TotalPendingCommits, Mode=OneWay}" FontSize="11" FontWeight="Bold"
                           Foreground="{DynamicResource {x:Static shell:VsBrushes.AccentDarkKey}}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </StackPanel>
          </Button>
        </StackPanel>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Path Width="18" Height="18" Data="{StaticResource RepositoryGeometry}" Stretch="Uniform"
                StrokeThickness="1.6" Stroke="{DynamicResource {x:Static shell:VsBrushes.ToolWindowTextKey}}" />
          <TextBlock Text="{Binding RepositoryCount, Mode=OneWay}" FontSize="15" FontWeight="SemiBold"
                     Margin="8,0,4,0" VerticalAlignment="Center" />
          <TextBlock Text="저장소" VerticalAlignment="Center" />
          <Border Width="1" Height="24" Margin="12,0"
                  Background="{DynamicResource {x:Static shell:VsBrushes.CommandBarToolBarSeparatorKey}}" />
          <Path Width="18" Height="18" Data="{StaticResource UploadGeometry}" Stretch="Uniform"
                StrokeThickness="1.8" Stroke="{DynamicResource {x:Static shell:VsBrushes.AccentLightKey}}" />
          <TextBlock Text="{Binding TotalPendingCommits, Mode=OneWay}" FontSize="15" FontWeight="SemiBold"
                     Margin="8,0,4,0" VerticalAlignment="Center" />
          <TextBlock Text="게시 대기" VerticalAlignment="Center" />
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Row="1">
      <Border Visibility="{Binding EmptyStateVisibility}" Padding="20" VerticalAlignment="Top">
        <StackPanel>
          <TextBlock Text="Git-SVN 저장소가 없습니다." FontWeight="SemiBold" />
          <TextBlock Text="Git-SVN 솔루션을 연 다음 새로 고침을 누르세요."
                     Style="{StaticResource SecondaryText}" Margin="0,4,0,0" />
        </StackPanel>
      </Border>

      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{Binding Repositories}" Margin="8,8,8,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Margin="0,0,0,8" CornerRadius="7"
                      Background="{DynamicResource {x:Static shell:VsBrushes.ComboBoxBackgroundKey}}"
                      BorderBrush="{DynamicResource {x:Static shell:VsBrushes.ToolWindowBorderKey}}"
                      BorderThickness="1" ClipToBounds="True">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>

                  <Grid Grid.Row="0" Margin="6,8,10,8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="32" />
                      <ColumnDefinition Width="24" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ToggleButton Grid.Column="0" Style="{StaticResource ChevronToggle}"
                                  IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                  ToolTip="저장소 커밋 목록 접기 또는 펼치기">
                      <Path Width="14" Height="10" Data="{StaticResource ChevronGeometry}"
                            Stretch="Uniform" StrokeThickness="1.7"
                            Stroke="{DynamicResource {x:Static shell:VsBrushes.ToolWindowTextKey}}"
                            RenderTransformOrigin="0.5,0.5">
                        <Path.Style>
                          <Style TargetType="Path">
                            <Setter Property="RenderTransform">
                              <Setter.Value><RotateTransform Angle="-90" /></Setter.Value>
                            </Setter>
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                           Value="True">
                                <Setter Property="RenderTransform">
                                  <Setter.Value><RotateTransform Angle="0" /></Setter.Value>
                                </Setter>
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Path.Style>
                      </Path>
                    </ToggleButton>

                    <Path Grid.Column="1" Width="18" Height="18" Data="{StaticResource RepositoryGeometry}"
                          Stretch="Uniform" StrokeThickness="1.5"
                          Stroke="{DynamicResource {x:Static shell:VsBrushes.ToolWindowTextKey}}"
                          VerticalAlignment="Center" />

                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="8,0,12,0">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Path}" FontFamily="Consolas" FontSize="11"
                                 Foreground="{DynamicResource {x:Static shell:VsBrushes.ToolWindowTextKey}}"
                                 TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                    </StackPanel>

                    <Border Grid.Column="3" Visibility="{Binding ProblemVisibility}" Margin="0,0,8,0"
                            Padding="8,4" CornerRadius="5"
                            Background="{DynamicResource {x:Static shell:VsBrushes.InfoBackgroundKey}}"
                            BorderBrush="{DynamicResource {x:Static shell:VsBrushes.InfoTextKey}}"
                            BorderThickness="1" ToolTip="{Binding Problem}">
                      <StackPanel Orientation="Horizontal">
                        <Path Width="15" Height="15" Data="{StaticResource WarningGeometry}" Stretch="Uniform"
                              StrokeThickness="1.7" Stroke="{DynamicResource {x:Static shell:VsBrushes.InfoTextKey}}" />
                        <TextBlock Text="{Binding ProblemLabel}" FontSize="11" FontWeight="SemiBold" Margin="6,0,0,0"
                                   Foreground="{DynamicResource {x:Static shell:VsBrushes.InfoTextKey}}"
                                   VerticalAlignment="Center" />
                      </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="4" Orientation="Horizontal">
                      <Button Style="{StaticResource IconButton}" Command="{Binding RebaseCommand}"
                              ToolTip="이 저장소에서 SVN 변경 받기" Margin="0,0,6,0">
                        <Path Data="{StaticResource DownloadGeometry}" Stretch="Uniform" StrokeThickness="1.8"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                      </Button>
                      <Button Style="{StaticResource PrimaryIconButton}" Command="{Binding DcommitCommand}"
                              ToolTip="이 저장소의 로컬 커밋을 SVN에 게시">
                        <Path Data="{StaticResource UploadGeometry}" Stretch="Uniform" StrokeThickness="1.8"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                      </Button>
                    </StackPanel>
                  </Grid>

                  <Border Grid.Row="1" Visibility="{Binding ExpandedVisibility}"
                          BorderThickness="0,1,0,0"
                          BorderBrush="{DynamicResource {x:Static shell:VsBrushes.ToolWindowBorderKey}}"
                          Padding="60,10,10,12">
                    <StackPanel>
                      <ItemsControl ItemsSource="{Binding PendingCommits}"
                                    Visibility="{Binding PendingCommitsVisibility}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Grid MinHeight="46" Margin="0,0,0,2">
                              <Border Width="2" HorizontalAlignment="Left" Margin="13,0,0,0"
                                      Background="{DynamicResource {x:Static shell:VsBrushes.AccentMediumKey}}" />
                              <Border Margin="28,0,0,0" CornerRadius="0,5,5,0"
                                      Background="{DynamicResource {x:Static shell:VsBrushes.CommandBarSelectedKey}}"
                                      BorderBrush="{DynamicResource {x:Static shell:VsBrushes.AccentLightKey}}"
                                      BorderThickness="3,0,0,0" Padding="10,5">
                                <Grid>
                                  <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                  </Grid.ColumnDefinitions>
                                  <Border Grid.Column="0" Width="26" Height="26" CornerRadius="13"
                                          BorderBrush="{DynamicResource {x:Static shell:VsBrushes.AccentLightKey}}"
                                          BorderThickness="1">
                                    <Path Width="14" Height="14" Data="{StaticResource UploadGeometry}" Stretch="Uniform"
                                          StrokeThickness="1.8"
                                          Stroke="{DynamicResource {x:Static shell:VsBrushes.CommandBarTextSelectedKey}}" />
                                  </Border>
                                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,10,0">
                                    <TextBlock Text="{Binding Subject}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource {x:Static shell:VsBrushes.CommandBarTextSelectedKey}}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                      <TextBlock Text="{Binding ShortHash}" FontFamily="Consolas" FontSize="11"
                                                 Foreground="{DynamicResource {x:Static shell:VsBrushes.CommandBarTextSelectedKey}}" />
                                      <TextBlock Text="  ·  " FontSize="11"
                                                 Foreground="{DynamicResource {x:Static shell:VsBrushes.CommandBarTextSelectedKey}}" />
                                      <TextBlock Text="{Binding Author}" FontSize="11"
                                                 Foreground="{DynamicResource {x:Static shell:VsBrushes.CommandBarTextSelectedKey}}" />
                                      <TextBlock Text="  ·  " FontSize="11"
                                                 Foreground="{DynamicResource {x:Static shell:VsBrushes.CommandBarTextSelectedKey}}" />
                                      <TextBlock Text="{Binding Date}" FontSize="11"
                                                 Foreground="{DynamicResource {x:Static shell:VsBrushes.CommandBarTextSelectedKey}}" />
                                    </StackPanel>
                                  </StackPanel>
                                  <Path Grid.Column="2" Width="15" Height="15" Data="{StaticResource UploadGeometry}"
                                        Stretch="Uniform" StrokeThickness="1.8"
                                        Stroke="{DynamicResource {x:Static shell:VsBrushes.CommandBarTextSelectedKey}}"
                                        VerticalAlignment="Center" Margin="8,0" />
                                </Grid>
                              </Border>
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>

                      <Grid Height="20" Visibility="{Binding PendingCommitsVisibility}">
                        <Border Height="1" Margin="28,0,0,0" VerticalAlignment="Bottom"
                                Background="{DynamicResource {x:Static shell:VsBrushes.AccentPaleKey}}" />
                        <Ellipse Width="7" Height="7" Margin="10,0,0,-3" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                 Fill="{DynamicResource {x:Static shell:VsBrushes.AccentPaleKey}}" />
                        <Border Width="24" Height="24" CornerRadius="12" Margin="0,0,8,-12"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                Background="{DynamicResource {x:Static shell:VsBrushes.ToolWindowBackgroundKey}}"
                                BorderBrush="{DynamicResource {x:Static shell:VsBrushes.AccentPaleKey}}"
                                BorderThickness="1">
                          <Path Width="14" Height="14" Data="{StaticResource ServerGeometry}" Stretch="Uniform"
                                StrokeThickness="1.5" Stroke="{DynamicResource {x:Static shell:VsBrushes.AccentLightKey}}" />
                        </Border>
                      </Grid>

                      <Grid MinHeight="46" Visibility="{Binding BaselineVisibility}">
                        <Border Width="2" HorizontalAlignment="Left" Margin="13,0,0,0"
                                Background="{DynamicResource {x:Static shell:VsBrushes.ToolWindowBorderKey}}" />
                        <Grid Margin="28,0,0,0">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <Border Grid.Column="0" Width="26" Height="26" CornerRadius="13"
                                  BorderBrush="{DynamicResource {x:Static shell:VsBrushes.AccentLightKey}}"
                                  BorderThickness="2" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Path Width="14" Height="14" Data="{StaticResource CheckGeometry}" Stretch="Uniform"
                                  StrokeThickness="2" Stroke="{DynamicResource {x:Static shell:VsBrushes.AccentLightKey}}" />
                          </Border>
                          <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SvnBaseline.Subject}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                              <TextBlock Text="{Binding SvnBaseline.ShortHash}" FontFamily="Consolas" FontSize="11" />
                              <TextBlock Text="  ·  SVN" FontSize="11" />
                            </StackPanel>
                          </StackPanel>
                          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,8,0">
                            <Path Width="14" Height="14" Data="{StaticResource CheckGeometry}" Stretch="Uniform"
                                  StrokeThickness="1.8" Stroke="{DynamicResource {x:Static shell:VsBrushes.AccentLightKey}}" />
                            <TextBlock Text="SVN" Margin="6,0,0,0" FontWeight="SemiBold" />
                          </StackPanel>
                        </Grid>
                      </Grid>

                      <TextBlock Visibility="{Binding NoPendingCommitsVisibility}"
                                 Text="게시할 로컬 커밋 없음" Style="{StaticResource SecondaryText}"
                                 Margin="28,4,0,2" />
                    </StackPanel>
                  </Border>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>

    <Border Grid.Row="2" Padding="10,6"
            Background="{DynamicResource {x:Static shell:VsBrushes.CommandBarGradientKey}}"
            BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource {x:Static shell:VsBrushes.CommandBarBorderKey}}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Horizontal">
          <Path Width="13" Height="13" Data="{StaticResource CheckGeometry}" Stretch="Uniform"
                StrokeThickness="1.8" Stroke="{DynamicResource {x:Static shell:VsBrushes.AccentLightKey}}" />
          <TextBlock Text="{Binding StatusText}" FontSize="11" Margin="7,0,0,0"
                     TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        </StackPanel>
        <ProgressBar Grid.Column="1" Width="72" Height="3" IsIndeterminate="True"
                     Visibility="{Binding BusyVisibility}" Margin="12,0,0,0" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <Grid x:Name="PublishOverlay" Grid.RowSpan="3"
          Visibility="{Binding PublishConfirmationVisibility, FallbackValue=Collapsed, TargetNullValue=Collapsed}"
          Background="#99000000"
          MouseLeftButtonDown="OnPublishOverlayMouseLeftButtonDown">
      <Border MinWidth="360" MaxWidth="520" Margin="24"
              HorizontalAlignment="Center" VerticalAlignment="Center"
              CornerRadius="8" ClipToBounds="True"
              Background="{DynamicResource {x:Static shell:VsBrushes.ComboBoxBackgroundKey}}"
              BorderBrush="{DynamicResource {x:Static shell:VsBrushes.ToolWindowBorderKey}}"
              BorderThickness="1">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <Border Grid.Row="0" Padding="16" BorderThickness="0,0,0,1"
                  BorderBrush="{DynamicResource {x:Static shell:VsBrushes.ToolWindowBorderKey}}">
            <StackPanel Orientation="Horizontal">
              <Border Width="38" Height="38" CornerRadius="6"
                      Background="{DynamicResource {x:Static shell:VsBrushes.CommandBarSelectedKey}}"
                      BorderBrush="{DynamicResource {x:Static shell:VsBrushes.AccentLightKey}}"
                      BorderThickness="1">
                <Path Width="22" Height="22" Data="{StaticResource UploadGeometry}" Stretch="Uniform"
                      StrokeThickness="1.9" Stroke="{DynamicResource {x:Static shell:VsBrushes.CommandBarTextSelectedKey}}" />
              </Border>
              <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="SVN에 게시" FontSize="17" FontWeight="SemiBold" />
                <TextBlock Text="{Binding PublishConfirmationSubtitle}" FontSize="11" Margin="0,3,0,0" />
              </StackPanel>
            </StackPanel>
          </Border>

          <StackPanel Grid.Row="1" Margin="16,10,16,0">
            <ItemsControl ItemsSource="{Binding PendingPublishItems}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid MinHeight="48">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="28" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="0" Width="16" Height="16" Data="{StaticResource UploadGeometry}"
                          Stretch="Uniform" StrokeThickness="1.8"
                          Stroke="{DynamicResource {x:Static shell:VsBrushes.AccentLightKey}}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="{Binding RepositoryName}" FontSize="12" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Subject}" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding ShortHash}" FontFamily="Consolas" FontSize="11"
                               Margin="12,0,0,0" VerticalAlignment="Center" />
                    <Border Grid.ColumnSpan="3" Height="1" VerticalAlignment="Bottom"
                            Background="{DynamicResource {x:Static shell:VsBrushes.ToolWindowBorderKey}}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Margin="0,12,0,0" Padding="10,8" CornerRadius="5"
                    Background="{DynamicResource {x:Static shell:VsBrushes.InfoBackgroundKey}}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Path Grid.Column="0" Width="17" Height="17" Data="{StaticResource WarningGeometry}" Stretch="Uniform"
                      StrokeThickness="1.7" Stroke="{DynamicResource {x:Static shell:VsBrushes.InfoTextKey}}"
                      VerticalAlignment="Top" Margin="0,1,8,0" />
                <TextBlock Grid.Column="1"
                           Text="저장소별 게시 작업은 하나의 트랜잭션이 아닙니다. 앞 저장소가 성공한 뒤 다음 저장소가 실패할 수 있습니다."
                           TextWrapping="Wrap" FontSize="11"
                           Foreground="{DynamicResource {x:Static shell:VsBrushes.InfoTextKey}}" />
              </Grid>
            </Border>
          </StackPanel>

          <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="16,14,16,16">
            <Button Style="{StaticResource ModernButton}" Content="취소"
                    Command="{Binding CancelPublishCommand}" Margin="0,0,8,0" />
            <Button Style="{StaticResource PrimaryButton}" Command="{Binding ConfirmPublishCommand}">
              <StackPanel Orientation="Horizontal">
                <Path Width="17" Height="17" Data="{StaticResource UploadGeometry}" Stretch="Uniform"
                      StrokeThickness="1.8"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                <TextBlock Text="게시 시작" Margin="7,0,0,0" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
