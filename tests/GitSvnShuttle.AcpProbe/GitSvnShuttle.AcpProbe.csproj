<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>GitSvnShuttle.AcpProbe</AssemblyName>
    <RootNamespace>GitSvnShuttle.AcpProbe</RootNamespace>
    <AcpLocale Condition="'$(AcpLocale)' == ''">ko-KR</AcpLocale>
    <ApplicationManifest Condition="'$(AcpLocale)' == 'ko-KR'">ko-KR.manifest</ApplicationManifest>
    <ApplicationManifest Condition="'$(AcpLocale)' == 'en-US'">en-US.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\GitSvnShuttle.Core\GitSvnShuttle.Core.csproj" />
  </ItemGroup>

  <Target Name="ValidateAcpLocale" BeforeTargets="PrepareForBuild"
          Condition="'$(AcpLocale)' != 'ko-KR' and '$(AcpLocale)' != 'en-US'">
    <Error Text="AcpLocale must be ko-KR or en-US." />
  </Target>
</Project>
